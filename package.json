{
  "name": "@rwcjs/core",
  "version": "3.1.0",
  "description": "Reactive web components on signals: typed tag factories instead of templates, effects that live and die with the component",
  "type": "module",
  "license": "MIT",
  "author": "tamazyanarsen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tamazyanarsen/reactive-web-components.git"
  },
  "homepage": "https://github.com/tamazyanarsen/reactive-web-components#readme",
  "bugs": {
    "url": "https://github.com/tamazyanarsen/reactive-web-components/issues"
  },
  "keywords": [
    "reactive",
    "signals",
    "web-components",
    "custom-elements",
    "typescript",
    "frontend",
    "ui",
    "no-jsx",
    "fine-grained-reactivity"
  ],
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "README.ru.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "bun --hot ./index.html",
    "dev:examples": "bun --hot ./examples/index.html",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "build:types": "dts-bundle-generator --project tsconfig.build.json --export-referenced-types false -o dist/index.d.ts index.ts",
    "build:js": "bun build ./index.ts --outdir=dist --target=browser --format=esm --sourcemap=linked",
    "build": "bun run typecheck && bun run test && bun run build:js && bun run build:types",
    "verify:package": "bun run scripts/verify-package.ts",
    "prepublishOnly": "bun run build && bun run verify:package",
    "cem": "custom-elements-manifest analyze",
    "size": "bun run scripts/check-size.ts",
    "build:packages": "bun run --filter '@rwcjs/router' --filter '@rwcjs/forms' build"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "0.10.4",
    "@happy-dom/global-registrator": "^20.14.0",
    "@types/bun": "latest",
    "dts-bundle-generator": "^9.5.1",
    "happy-dom": "^20.14.0"
  },
  "peerDependencies": {
    "typescript": ">=5"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "workspaces": [
    "packages/*"
  ]
}
