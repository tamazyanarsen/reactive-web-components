{
  "name": "@reactive-web-components/rwc",
  "version": "2.66.5",
  "description": "Modern library for creating reactive web components with declarative syntax and strict typing",
  "type": "module",
  "keywords": [
    "reactive",
    "web-components",
    "signals",
    "typescript",
    "framework",
    "components",
    "reactive-framework",
    "declarative",
    "custom-elements",
    "ui",
    "frontend"
  ],
  "author": "tamazyanarsen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tamazyanarsen/reactive-web-components.git"
  },
  "homepage": "https://github.com/tamazyanarsen/reactive-web-components#readme",
  "bugs": {
    "url": "https://github.com/tamazyanarsen/reactive-web-components/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build:watch": "rslib build --watch",
    "build": "rslib build",
    "dev": "rsbuild dev",
    "docs": "typedoc --exclude \"**/index.ts\" --entryPointStrategy Expand ./src/shared/",
    "changelog": "git-cliff -o CHANGELOG.md",
    "upload": "npm publish ./dist --access public",
    "build:upload": "npm run build && npm run upload && npm run changelog && git commit -am \"chore: changelog\"",
    "release:patch": "npm version patch && npm run build:upload && git push",
    "release:minor": "npm version minor && npm run build:upload && git push",
    "release:major": "npm version major && npm run build:upload && git push",
    "prepare": "husky",
    "check": "biome check --write",
    "format": "biome format --write"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.6",
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "@rsbuild/plugin-sass": "^1.5.1",
    "@rslib/core": "^0.20.0",
    "@types/node": "^24.12.0",
    "git-cliff": "^2.12.0",
    "husky": "^9.1.7",
    "typedoc": "^0.27.6",
    "typescript": "^5.8"
  }
}
