{
  "name": "@reactive-web-components/rwc",
  "version": "3.1.0",
  "description": "Modern library for creating reactive web components with declarative syntax and strict typing",
  "type": "module",
  "keywords": [
    "reactive",
    "web-components",
    "signals",
    "typescript",
    "framework",
    "components",
    "reactive-framework",
    "declarative",
    "custom-elements",
    "ui",
    "frontend"
  ],
  "author": "tamazyanarsen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tamazyanarsen/reactive-web-components.git"
  },
  "homepage": "https://github.com/tamazyanarsen/reactive-web-components#readme",
  "bugs": {
    "url": "https://github.com/tamazyanarsen/reactive-web-components/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:watch": "vite build --watch",
    "preview": "vite preview",
    "docs": "npx typedoc --exclude \"**/index.ts\" --entryPointStrategy Expand ./src/shared/",
    "lint": "npx eslint ./src/",
    "upload": "npm publish ./dist --access public",
    "build:upload": "npm run build && npm run upload",
    "release": "npm version $npm_config_type && npm run build:upload && git push",
    "release:patch": "npm version patch && npm run build:upload && git push",
    "release:minor": "npm version minor && npm run build:upload && git push",
    "release:major": "npm version major && npm run build:upload && git push",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.7.5",
    "eslint": "^9.19.0",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "sass-embedded": "^1.83.0",
    "ts-jest": "^29.3.1",
    "typedoc": "^0.27.6",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.22.0",
    "vite": "^5.4.1",
    "vite-plugin-checker": "^0.8.0",
    "vite-plugin-dts": "^4.5.3"
  }
}
