{
  "name": "@rwcjs/ui",
  "version": "0.1.2",
  "description": "UI kit on @rwcjs/core: accessible web components themed with CSS custom properties, light and dark out of the box",
  "type": "module",
  "license": "MIT",
  "author": "tamazyanarsen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tamazyanarsen/reactive-web-components.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/tamazyanarsen/reactive-web-components/tree/main/packages/ui#readme",
  "keywords": [
    "ui",
    "components",
    "web-components",
    "design-system",
    "microfrontends",
    "rwc",
    "custom-elements"
  ],
  "sideEffects": [
    "*.css"
  ],
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme.css": "./dist/theme.css"
  },
  "files": [
    "dist",
    "custom-elements.json",
    "README.md"
  ],
  "scripts": {
    "build": "bun build ./src/index.ts --outdir=dist --target=browser --format=esm --sourcemap=linked --external @rwcjs/core && tsc -p tsconfig.build.json && cp src/theme.css dist/theme.css && custom-elements-manifest analyze",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "@rwcjs/core": "^3.2.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "customElements": "custom-elements.json"
}
