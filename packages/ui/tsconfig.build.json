{
  // Только декларации. tsc сохраняет импорт "@rwcjs/core" как есть — типы ядра берутся
  // из установленного пакета, а не копируются (копия бренда SIGNAL сломала бы совместимость).
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "allowImportingTsExtensions": false,
    "types": [],
    // Ядро — собранными типами (bun run build в корне), иначе tsc потянет его исходники.
    "paths": { "@rwcjs/core": ["../../dist/index.d.ts"] },
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "src/test-utils.ts"]
}
