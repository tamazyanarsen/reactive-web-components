{
  // scripts/ и dist/ проверяются отдельно: скрипт верификации импортирует собранный
  // пакет, которого на момент typecheck ещё нет, а dist — это артефакт сборки.
  "exclude": ["dist", "scripts", "bench", "packages/create/templates/*/vite.config.ts"],
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "types": ["bun"],

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    // Пакеты из packages/* импортируют ядро по имени — в репозитории это исходники.
    "paths": {
      "@rwcjs/core": ["./index.ts"],
      "@rwcjs/router": ["./packages/router/src/index.ts"],
      "@rwcjs/forms": ["./packages/forms/src/index.ts"],
      "@rwcjs/cem-plugin": ["./packages/cem-plugin/index.js"]
    },
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  }
}
